terraform {
  required_version = "{{ if and (eq .Backend "s3") .Cloud.S3Lock }}>= 1.10{{ else if eq .Backend "s3" }}>= 1.6{{ else }}>= 1.5{{ end }}"

  required_providers {
    {{ .Cloud.Name }} = {
      source  = "{{ .Cloud.Source }}"
      version = "{{ .Cloud.Version }}"
    }
  }
}

locals {
  environment = {{ if eq .Layout "workspaces" }}terraform.workspace{{ else }}"{{ .Env }}"{{ end }}
}

# Credentials come from the {{ .Cloud.TokenEnv }} environment variable.
provider "{{ .Cloud.Name }}" {}

module "network" {
  source = "{{ .ModuleSource }}"

  name   = "${var.project}-${local.environment}"
  region = var.region
  cidr   = var.network_cidr
}
