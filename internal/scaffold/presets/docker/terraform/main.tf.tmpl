terraform {
  required_version = ">= 1.5"

  required_providers {
    docker = {
      source  = "kreuzwerker/docker"
      version = "~> 3.0"
    }
  }
}

locals {
  environment = {{ if eq .Layout "workspaces" }}terraform.workspace{{ else }}"{{ .Env }}"{{ end }}
}

# Uses the local Docker daemon; set DOCKER_HOST (e.g. ssh://user@host) for a remote one.
provider "docker" {}

module "network" {
  source = "{{ .ModuleSource }}"

  name = "${var.project}-${local.environment}"
  cidr = var.network_cidr
}

resource "docker_image" "web" {
  name = var.web_image
}

resource "docker_container" "web" {
  name  = "${var.project}-${local.environment}-web"
  image = docker_image.web.image_id

  networks_advanced {
    name = module.network.network_name
  }

  dynamic "ports" {
    for_each = var.web_ports
    content {
      internal = ports.value.internal
      external = ports.value.external
      ip       = ports.value.ip
      protocol = ports.value.protocol
    }
  }
}
