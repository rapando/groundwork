output "network_id" {
  value = module.network.network_id
}

output "web_ports" {
  description = "Host ports the web container is published on."
  value       = docker_container.web.ports
}

# Hosts for Ansible. Containers have no SSH, so reach them through the Docker
# connection plugin (community.docker collection), e.g.
#   { web = [{ name = "web", ansible_host = docker_container.web.name, ansible_connection = "community.docker.docker" }] }
output "ansible_hosts" {
  description = "Map of Ansible group to list of {name, ip, ...any host variables}."
  value       = {}
}
