[defaults]
inventory         = inventory
roles_path        = roles
host_key_checking = True
retry_files_enabled = False
interpreter_python = auto_silent
{{- if .VaultPasswordFile }}
# The ansible-vault password file is set in groundwork.yaml ({{ .VaultPasswordFile }}).
# To use it outside groundwork: ansible-playbook --vault-password-file={{ .VaultPasswordFile }}
{{- else }}
# No ansible-vault password file: type the password in groundwork
# (Variables → Secrets → Unlock), which keeps it in memory only.
# Outside groundwork: ansible-playbook --ask-vault-pass
{{- end }}
