repos:
  - repo: https://github.com/antonbabenko/pre-commit-terraform
    rev: v1.96.1
    hooks:
      - id: terraform_fmt
{{- if .HasCheck "tflint" }}
      - id: terraform_tflint
{{- end }}
{{- if .HasCheck "yamllint" }}
  - repo: https://github.com/adrienverge/yamllint
    rev: v1.35.1
    hooks:
      - id: yamllint
{{- end }}
{{- if .HasCheck "ansible-lint" }}
  - repo: https://github.com/ansible/ansible-lint
    rev: v24.9.2
    hooks:
      - id: ansible-lint
{{- end }}
