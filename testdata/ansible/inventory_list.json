{
    "_meta": {
        "hostvars": {
            "db-1": {
                "ansible_connection": "local",
                "ansible_python_interpreter": "{{ ansible_playbook_python }}",
                "app_port": 8080
            },
            "down-1": {
                "ansible_host": "127.0.0.1",
                "ansible_port": 1,
                "ansible_python_interpreter": "{{ ansible_playbook_python }}",
                "ansible_ssh_common_args": "-o ConnectTimeout=2 -o StrictHostKeyChecking=no",
                "ansible_user": "nobody",
                "app_port": 8080
            },
            "web-1": {
                "ansible_connection": "local",
                "ansible_python_interpreter": "{{ ansible_playbook_python }}",
                "app_port": 8080,
                "log_level": "info",
                "nginx_workers": 4
            },
            "web-2": {
                "ansible_connection": "local",
                "ansible_python_interpreter": "{{ ansible_playbook_python }}",
                "app_port": 8080,
                "log_level": "info",
                "nginx_workers": 3,
                "tier": "canary"
            }
        },
        "profile": "inventory_legacy"
    },
    "all": {
        "children": [
            "ungrouped",
            "web",
            "db",
            "flaky"
        ]
    },
    "db": {
        "hosts": [
            "db-1"
        ]
    },
    "flaky": {
        "hosts": [
            "down-1"
        ]
    },
    "web": {
        "hosts": [
            "web-1",
            "web-2"
        ]
    }
}
